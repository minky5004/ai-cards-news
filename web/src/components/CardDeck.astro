---
import type { RenderedCard } from "../lib/content";

interface Props {
  cards: RenderedCard[];
  /**
   * 첫 카드에 붙일 view transition 이름. 아카이브 더미의 표지와 같은 이름을 주면
   * 더미를 눌러 들어올 때 표지가 그대로 첫 카드가 된다. 홈의 오늘 발행처럼 이어질
   * 상대가 없는 자리에서는 주지 않는다 — 이름은 한 화면에 하나뿐이어야 한다.
   */
  coverName?: string;
}

const { cards, coverName } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageBase = base.replace(/\/$/, "");
---

{/*
  가로 스와이프 캐러셀. 스크롤·스냅·스와이프는 전부 CSS(overflow + scroll-snap)가
  하고, JS 는 좌우 버튼과 도트만 얹는다. 그래서 스크립트가 실패하거나 아직 안
  왔어도 카드를 넘겨보는 일 자체는 된다 — 컨트롤은 JS 가 켜기 전까지 숨어 있다.
  외부 캐러셀 라이브러리를 쓰지 않는 이유는 웹폰트를 안 싣는 것과 같다: 이 페이지가
  하는 일에 비해 지불이 크다.
*/}
{/*
  `data-unfold` 는 여기서 달지 않는다. 마크업에 박으면 더미에서 이어진 이동이
  아닐 때에도 걸려, 새로고침이나 즐겨찾기 진입에서 첫 장만 있고 나머지가 비어
  있는 화면이 뜬다. 이동 직전에 짝을 확인한 `Layout` 이 붙여 준다.
*/}
<section
  class="carousel"
  data-carousel
  role="region"
  aria-roledescription="캐러셀"
  aria-label="카드 목록"
>
  <div class="stage">
    {
      cards.length > 1 && (
        <button class="arrow arrow-prev" type="button" data-prev aria-label="이전 카드" hidden>
          <span aria-hidden="true">←</span>
        </button>
      )
    }

    <ol class="track" data-track tabindex="0">
      {
        cards.map((card, i) => (
          <li
            class:list={["slide", { "is-active": i === 0 }]}
            style={`--n: ${i}`}
            data-slide
            aria-roledescription="슬라이드"
            aria-label={`${i + 1} / ${cards.length}`}
          >
            {/*
              스크립트가 붙으면 이 링크가 확대 뷰를 연다. 붙기 전이거나 실패하면
              원문으로 나가는 원래 동작이 그대로 산다 — 카드 이미지에는 헤드라인밖에
              없으므로 어느 쪽이든 막다른 길이 되면 안 된다.
            */}
            <a class="shot" href={card.sourceUrl} target="_blank" rel="noopener noreferrer">
              {/*
                1080x1350 을 명시해 이미지가 늦게 와도 레이아웃이 밀리지 않게 한다.
                앞 두 장만 eager 로 받는다 — 가로 스크롤에서도 lazy 는 트랙 기준으로
                동작하므로 나머지는 넘길 때 받는다.
              */}
              {/*
                `transition:name` 디렉티브를 쓰면 안 된다 — 값이 undefined 여도 Astro 가
                자동 생성 이름을 붙여, 카드 다섯 장이 전부 각자 전환 대상이 된다. 확대할
                때 카드가 여러 장 한꺼번에 움직이는 정체가 그것이었다. 이름이 필요한
                자리에만 CSS 속성으로 직접 준다.
              */}
              <img
                data-vt={i === 0 && coverName ? coverName : undefined}
                style={i === 0 && coverName ? `view-transition-name: ${coverName}` : undefined}
                src={`${imageBase}${card.image}`}
                width="1080"
                height="1350"
                alt={`${card.headline} — ${card.body}`}
                loading={i < 2 ? "eager" : "lazy"}
                decoding="async"
              />
            </a>
            <p class="meta">
              <a href={card.sourceUrl} target="_blank" rel="noopener noreferrer">
                {card.sourceName} 원문 보기 →
              </a>
            </p>

            {/*
              확대 뷰. 스크립트로 조립하지 않고 서버에서 미리 그린다 — 본문은 이제
              카드 이미지에 없으므로, 여기에도 없으면 검색엔진과 스크린리더에게는
              그 글이 아예 존재하지 않는 것이 된다. 닫혀 있는 dialog 라도 마크업에는
              남아 있다.
            */}
            <dialog class="expand" data-expand aria-label={`${card.headline} 자세히`}>
              {/*
                `method="dialog"` 인 폼의 제출 버튼은 스크립트 없이 dialog 를 닫는다.
                닫기 동작을 우리가 붙이지 않으므로 스크립트가 죽어도 열린 확대 뷰에
                갇히지 않는다.
              */}
              <form class="close-row" method="dialog">
                <button class="close" type="submit" data-close aria-label="닫기">
                  <span aria-hidden="true">✕</span>
                </button>
              </form>

              <div class="expand-inner">
                <img
                  class="expand-shot"
                  src={`${imageBase}${card.image}`}
                  width="1080"
                  height="1350"
                  alt={card.headline}
                  loading="lazy"
                  decoding="async"
                />

                <div class="detail">
                  <h2>{card.headline}</h2>
                  <p class="body">{card.body}</p>
                  <a
                    class="origin"
                    href={card.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {card.sourceName} 원문 보기 ↗
                  </a>
                </div>
              </div>
            </dialog>
          </li>
        ))
      }
    </ol>

    {
      cards.length > 1 && (
        <button class="arrow arrow-next" type="button" data-next aria-label="다음 카드" hidden>
          <span aria-hidden="true">→</span>
        </button>
      )
    }
  </div>

  {
    cards.length > 1 && (
      <ol class="dots" data-dots hidden>
        {cards.map((_, i) => (
          <li>
            <button type="button" data-dot aria-label={`${i + 1}번째 카드로 이동`} />
          </li>
        ))}
      </ol>
    )
  }
</section>

<style>
  .carousel {
    /*
      카드는 4:5 세로다. 폭·뷰포트 높이 양쪽으로 상한을 걸어, 가로로 눕힌 화면에서
      카드 아래가 잘리지 않게 한다(55vh 폭 = 68.75vh 높이).
    */
    --slide: min(78vw, 420px, 55vh);
    /* 펼치기가 "한 칸 옆" 을 계산해야 해서 간격도 값으로 둔다. */
    --gap: 20px;
  }

  .stage {
    position: relative; /* 화살표를 이 안에서 절대배치하는 기준 */
  }

  .track {
    position: relative; /* 슬라이드 offsetLeft 를 트랙 기준으로 만든다(스크립트가 쓴다) */
    list-style: none;
    margin: 0;
    /* 첫 장과 마지막 장도 가운데에 설 수 있도록 좌우를 비워 둔다. */
    padding: 0 max(0px, calc((100% - var(--slide)) / 2));
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 20px;
  }

  .slide {
    flex: 0 0 var(--slide);
    scroll-snap-align: center;
  }

  /*
    날짜 페이지에 들어설 때 표지 다음 장들이 <b>바로 앞 장 뒤에서 한 칸씩 미끄러져
    나온다.</b> 더미에서 카드를 한 장씩 뽑아 늘어놓는 동작이다.

    한때 시작점이 `-26px` 이었다. 카드 폭이 420px 이니 6%고, 그래서 "표지만 날아오고
    나머지는 그냥 나타난다"로 읽혔다 — 어디서 왔는지 알 수 없는 자리에서 페이드인하는
    것과 같다. <b>의미가 있는 시작점은 앞 장이 있던 자리 하나뿐이다.</b>

    전부 표지 자리(`--n` 칸)에서 출발시키는 쪽도 재 봤는데, 이동 거리가 장마다 달라
    속도가 제각각이 되고 뒤 장이 앞 장 사이의 틈으로 스쳐 지나간다. 한 칸씩이면 거리가
    모두 같고, 보이지 않는 자리의 장은 화면에 나타나지도 않는다.

    첫 장(n=0)은 문서 간 전환이 맡으므로 건드리지 않는다. 지연은 그 전환이 끝나는
    시점에 맞춰 시작한다.
  */
  [data-unfold] .slide {
    /*
      뒤 장이 앞 장을 밟으면 "뒤에서 나온다"가 아니라 "위로 지나간다"가 된다.
      flex 아이템은 `position` 없이도 `z-index` 가 먹는다.
    */
    z-index: calc(10 - var(--n));
  }

  [data-unfold] .slide:not(:first-child) {
    animation: unfold 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(160ms + var(--n) * 55ms);
  }

  @keyframes unfold {
    from {
      opacity: 0;
      transform: translateX(calc((var(--slide) + var(--gap)) * -1));
    }
  }

  /*
    가운데 카드만 또렷하게. 양옆은 다음 장이 있다는 신호로만 남긴다.
    이 흐림은 스크립트가 `data-enhanced` 를 붙인 뒤에만 건다 — 현재 장을 따라가는
    것도 스크립트라, 게이트가 없으면 JS 가 아직 안 왔거나 실패했을 때 카드 전체가
    흐린 채로 굳는다.
  */
  [data-enhanced] .slide:not(.is-active) {
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }

  .shot {
    display: block;
  }

  /*
    카드는 종이 위에 놓인 인쇄물이다. 옅은 그림자와 실선 테두리로 크림 바탕에서
    가장자리를 분명히 한다 — 카드 안이 딥 네이비라 크림 위에서는 저절로 도드라진다.
  */
  /*
    `.slide img` 로 잡으면 안 된다 — 확대 뷰의 이미지도 슬라이드 안에 있어서 함께
    걸리고, 특이성이 `.expand-shot` 보다 높아 확대 뷰의 크기 지정을 덮어 버린다.
  */
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    background: var(--paper-sunken);
    border: 1px solid var(--rule);
    box-shadow: 0 14px 34px rgba(22, 24, 29, 0.18);
  }

  .meta {
    margin: 14px 2px 0;
    font-size: 12.5px;
    color: var(--text-faint);
    text-align: center;
  }

  .meta a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .meta a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* 카드 폭 밖 여백에 앉는 원형 버튼. 기본은 숨김 — 640px 미만은 스와이프·도트로만 넘긴다. */
  .arrow {
    display: none;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--paper-raised);
    color: var(--text-soft);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  /* JS 가 아직 안 왔거나 실패하면 화살표는 계속 숨어 있다 — 스와이프는 그대로 산다. */
  .arrow[hidden] {
    display: none;
  }

  .arrow:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .arrow:disabled {
    opacity: 0.25;
    cursor: default;
  }

  /*
    데스크톱·태블릿 이상에서만 화살표를 카드 옆에 띄운다. `.stage` 에 여백을
    미리 비워 둬 화살표가 앉을 자리가 배경(빈 공간)이 되게 한다 — 이웃 카드
    이미지를 밟지 않는다. 모바일은 그 여백을 확보할 폭이 없어 화살표를 접고
    스와이프·도트로만 넘긴다. `.arrow` 의 `display: none` 과 특이성이 같으므로
    이 규칙을 소스 순서상 뒤에 둬야 이긴다.
  */
  @media (min-width: 640px) {
    .stage {
      padding-inline: clamp(40px, 6vw, 56px);
    }

    .arrow-prev,
    .arrow-next {
      display: grid;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
    }

    .arrow-prev {
      left: 0;
    }

    .arrow-next {
      right: 0;
    }
  }

  .dots {
    margin: 22px 0 0;
    list-style: none;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .dots[hidden] {
    display: none;
  }

  .dots button {
    display: block;
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--rule);
    cursor: pointer;
    transition: background 0.2s ease, width 0.2s ease;
  }

  .dots button:hover {
    background: var(--text-faint);
  }

  /* 현재 위치는 이 페이지에서 액센트가 면으로 쓰이는 유일한 자리다. */
  .dots button[aria-current="true"] {
    width: 22px;
    border-radius: 4px;
    background: var(--accent);
  }

  /*
    확대 뷰. 카드 이미지를 크게 다시 보여 주는 자리가 아니라, 카드에서 빠진 본문을
    읽는 자리다 — 그래서 이미지와 글이 같은 무게로 선다.
  */
  .expand {
    width: min(980px, calc(100vw - 32px));
    max-height: calc(100vh - 48px);
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 18px;
    background: var(--paper-raised);
    color: var(--text);
    overflow: auto;
    overscroll-behavior: contain;
  }

  .expand::backdrop {
    background: rgba(22, 24, 29, 0.62);
  }

  /*
    카드를 4:5 그대로 폭에 맞춰 깔면 이미지 하나가 확대 뷰를 통째로 먹고 본문이
    스크롤 아래로 밀린다 — 본문을 읽으라고 만든 자리인데 본문이 안 보인다.
    높이로 상한을 걸고 `contain` 으로 담아 카드 전체가 잘리지 않게 한다(헤드라인이
    카드 아래쪽에 있어 `cover` 로 자르면 헤드라인부터 없어진다).
  */
  .expand-shot {
    display: block;
    width: 100%;
    height: auto;
    max-height: 44vh;
    object-fit: contain;
    background: var(--paper-sunken);
    border-bottom: 1px solid var(--rule);
  }

  /* 폭이 나면 이미지와 글을 나란히 세운다. 둘 다 한눈에 들어와야 한다. */
  @media (min-width: 760px) {
    .expand-inner {
      display: grid;
      /* minmax(0, …) 이어야 긴 출처명 한 줄이 열을 밀어내지 않는다. */
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
    }

    .expand-shot {
      width: auto;
      height: min(68vh, 540px);
      max-height: none;
      border-bottom: 0;
      border-right: 1px solid var(--rule);
    }
  }

  /*
    높이 0 의 sticky 줄. 닫기 버튼을 그냥 absolute 로 두면 스크롤 컨테이너 안이라
    본문을 내리는 순간 위로 사라진다 — 확대 뷰는 이미지와 본문이 함께 들어가 실제로
    스크롤된다.
  */
  .close-row {
    position: sticky;
    top: 0;
    z-index: 2;
    height: 0;
  }

  .close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    /* 카드 이미지 위에 앉으므로 종이색으로 띄워야 보인다. */
    background: var(--paper-raised);
    color: var(--text-soft);
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .close:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .detail {
    padding: clamp(20px, 4vw, 30px);
  }

  .detail h2 {
    margin: 0;
    font-size: clamp(20px, 3.4vw, 27px);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
    word-break: keep-all;
  }

  .detail .body {
    margin: 14px 0 0;
    font-size: clamp(14.5px, 2.2vw, 16.5px);
    line-height: 1.75;
    color: var(--text-soft);
    word-break: keep-all;
  }

  .detail .origin {
    display: inline-block;
    margin-top: 22px;
    padding: 9px 16px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-soft);
    text-decoration: none;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .detail .origin:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    /* 흐림 규칙보다 특이성이 낮으면 안 먹으므로 같은 선택자로 되돌린다. */
    [data-enhanced] .slide:not(.is-active),
    .dots button,
    .arrow {
      transition: none;
    }

    /* 펼치기는 장식이다. 끄면 카드가 그냥 제자리에 있어야지 사라지면 안 된다. */
    [data-unfold] .slide:not(:first-child) {
      animation: none;
    }
  }
</style>

{/*
  view transition 의 가짜 요소(`::view-transition-*`)는 문서 루트에 붙으므로 컴포넌트
  스코프 스타일로는 닿지 않는다. 전역으로 쓰되 카드 morph 중에만 걸리게 표시로 막는다 —
  더미에서 날짜 페이지로 넘어가는 전환은 화면이 통째로 바뀌는 것이라 교차 페이드가 맞다.
*/}
<style is:global>
  /*
    쌓임 순서가 이 연출의 전부다. 아래에서부터 페이지 → 패널 → 카드다.

    카드가 패널보다 위여야 한다. 지정하지 않으면 패널이 불투명해지는 순간
    자라나는 카드를 덮어, 확대 뷰가 반쯤 빈 종이로 보이다가 카드가 튀어나온다.

    한때 루트를 `animation: none; opacity: 0/1` 로 즉시 갈아 세웠다. 패널에 이름이
    없던 시절 옛 화면이 불투명한 채 얼어붙어 확대 뷰를 덮었기 때문인데, 그 대가로
    <b>화면이 어두워지는 것이 0프레임에 툭 켜졌다</b> — 어두운 배경은 새 루트에
    딸려 있어 루트를 즉시 세우면 같이 즉시 켜진다. 닫을 때는 반대로 80ms 만에
    통째로 밝아지고 패널 잔상만 남았다. 이제 패널이 z-index 1 로 제 자리를 지키므로
    루트는 기본 교차 페이드로 되돌린다 — 두 루트는 어두워짐 말고는 같은 그림이라,
    그 교차 페이드가 곧 배경이 서서히 깔리는 연출이 된다.

    `data-card-morph` 는 `Layout` 도 본다. 거기서 페이지 이동에 거는 순차 페이드를
    이 표시가 있을 때 비켜 준다 — 여기서 필요한 것이 정확히 그 반대이기 때문이다.
  */
  html[data-card-morph]::view-transition-group(card-panel) {
    z-index: 1;
  }

  html[data-card-morph]::view-transition-group(card-morph) {
    z-index: 2;
  }

  /* 1박 — 사진이 카드 자리에서 확대 뷰 안의 제자리로 간다. */
  html[data-card-morph]::view-transition-group(card-morph) {
    animation-duration: 240ms;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }

  /*
    2박 — 종이가 그 사진 자리에서부터 펴진다.

    크기를 늘리지 않고 <b>잘라 드러낸다</b>. 늘리면 스냅샷이 함께 늘어나 글자가
    가로로 눌린 채 커진다. `--panel-seed` 는 확대 뷰 안에서 사진이 차지한 영역이라
    좁은 화면(사진이 위, 글이 아래)에서는 펴지는 방향이 아래로 저절로 바뀐다.
  */
  html[data-card-morph="open"]::view-transition-new(card-panel) {
    animation: panel-unfold 260ms cubic-bezier(0.22, 1, 0.36, 1) 150ms both;
  }

  /*
    투명도가 키프레임에 있어야 한다. 지연·유지 구간에서 브라우저가 `from`·`to` 를
    붙들고 있기 때문이다 — 없이 두면 <b>사진이 도착하기도 전에 종이 기둥이 떠 있고</b>,
    닫을 때는 접힌 기둥이 사진이 카드로 돌아갈 때까지 남는다. 둘 다 프레임에서 봤다.
    기둥이 보이는 구간은 사진이 그 자리를 정확히 덮고 있는 동안뿐이다.
  */
  @keyframes panel-unfold {
    from {
      clip-path: inset(var(--panel-seed, 0px 0px 0px 0px) round 18px);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    to {
      clip-path: inset(0px round 18px);
      opacity: 1;
    }
  }

  /* 닫을 때는 차례가 반대다 — 종이가 먼저 접히고 사진이 뒤따라 돌아간다. */
  html[data-card-morph="close"]::view-transition-old(card-panel) {
    animation: panel-fold 190ms ease both;
  }

  @keyframes panel-fold {
    from {
      clip-path: inset(0px round 18px);
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    to {
      clip-path: inset(var(--panel-seed, 0px 0px 0px 0px) round 18px);
      opacity: 0;
    }
  }

  /* 자체 애니메이션이 기본값을 대신하므로 합성 방식도 직접 못박는다. */
  html[data-card-morph="open"]::view-transition-new(card-panel),
  html[data-card-morph="close"]::view-transition-old(card-panel) {
    mix-blend-mode: normal;
  }

  html[data-card-morph="close"]::view-transition-group(card-morph) {
    animation-delay: 170ms;
    animation-fill-mode: both;
  }

  /*
    배경이 밝아지는 것도 사진이 돌아오는 데 맞춘다. 기본 250ms 로 두면 사진이
    아직 카드에 닿기 전에 배경이 다 밝아져 둘이 따로 논다.
  */
  html[data-card-morph="close"]::view-transition-old(root),
  html[data-card-morph="close"]::view-transition-new(root) {
    animation-duration: 410ms;
  }
</style>

<script>
  /*
    한 페이지에 덱이 하나뿐이지만 컴포넌트라 여러 개를 가정하고 각각 묶는다.
    현재 장 판정은 IntersectionObserver 가 아니라 "트랙 중앙에 가장 가까운 슬라이드"
    로 한다 — 데스크톱에서는 이웃 카드까지 온전히 보여서 교차 비율로는 가운데를
    가릴 수 없다.
  */
  /*
    설정을 켤 때마다 읽는다. 모듈 스코프에서 한 번만 재면 그 값이 페이지를 옮겨도
    그대로 남아, 이용자가 도중에 설정을 바꿔도 반영되지 않는다 — 스크립트는 처음
    한 번만 실행되기 때문이다.
  */
  const quiet = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  /*
    배선을 함수로 묶어 `astro:page-load` 마다 다시 건다.

    ClientRouter 가 붙은 뒤로 페이지 이동이 문서 교체가 아니라 DOM 교체가 됐다.
    모듈 스크립트는 처음 한 번만 실행되므로, 묶어 두지 않으면 <b>이동한 페이지에서
    캐러셀과 확대가 통째로 죽는다</b> — 화살표·도트가 숨은 채 남고 카드를 눌러도
    아무 일도 일어나지 않는다. 실제로 그 상태를 재현하고 나서 이 구조로 왔다.

    `astro:page-load` 는 첫 진입에도 발화하므로 여기서만 부르면 된다.
  */
  let wiring: AbortController | null = null;

  const setup = () => {
    /*
      DOM 은 교체돼도 window 는 남는다. 지난 배선의 resize 청취자를 끊지 않으면
      이동할 때마다 하나씩 쌓인다.
    */
    wiring?.abort();
    wiring = new AbortController();
    const signal = wiring.signal;

  /*
    카드를 누르면 원문으로 나가는 대신 확대 뷰를 연다. 카드 이미지에는 헤드라인밖에
    없으므로 본문을 읽을 자리가 필요하고, 그 자리가 곧 카드 자신이어야 한다.

    캐러셀 배선과 떼어 놓은 것은 <b>카드가 한 장인 날에도 확대는 돼야 하기 때문</b>이다.
    아래 캐러셀 쪽은 슬라이드가 둘 미만이면 통째로 건너뛴다.
  */
  const DRAG_SLOP = 10;

  /*
    확대는 두 박자다 — <b>사진이 먼저 제자리로 가고, 그 사진 자리에서 종이가 펴진다.</b>

    한 박자로 두면 종이가 제자리에서 나타나고 사진이 거기로 끌려가는 것처럼 보인다.
    상자에 짝을 줘 카드 크기에서 확대 크기로 늘려도 봤는데, 그러면 종이 스냅샷이
    함께 늘어나 <b>글자가 가로로 눌린 채 커진다.</b> 그래서 종이는 크기를 바꾸지 않고
    사진이 차지한 영역에서부터 잘라 드러낸다 — 글자는 처음부터 제 크기다.

    닫을 때는 순서가 반대다. 종이가 사진 자리로 접히고, 그다음 사진이 카드로 돌아간다.

    지원하지 않는 브라우저나 모션을 줄인 설정에서는 그냥 즉시 열고 닫는다 — 효과가
    없을 뿐 동작은 같다.
  */
  const MORPH = "card-morph";
  const PANEL = "card-panel";

  const morph = (
    fromImage: HTMLElement,
    toImage: HTMLElement,
    panel: HTMLDialogElement,
    swap: () => void,
  ) => {
    if (quiet() || !document.startViewTransition) {
      swap();
      return;
    }

    /*
      쌓임 순서와 두 박자의 차례를 정하는 전역 스타일이 이 표시를 보고 갈라진다.
      문서 간 이동에는 걸리지 않아야 해서 morph 중에만 붙인다.
    */
    const opening = !panel.open;
    document.documentElement.dataset.cardMorph = opening ? "open" : "close";

    /*
      종이가 펴져 나올 씨앗 자리 — 확대 뷰 안에서 사진이 차지하는 영역이다. 넓은
      화면에서는 왼쪽 열, 좁은 화면에서는 위쪽 띠라 <b>펴지는 방향이 저절로 갈린다</b>.
      확대 뷰가 열려 있어야 잴 수 있으므로 여는 쪽은 전환 콜백 안에서 잰다.
    */
    const inner = panel.contains(toImage) ? toImage : fromImage;
    const seed = () => {
      const box = panel.getBoundingClientRect();
      const shot = inner.getBoundingClientRect();
      const gap = (n: number) => `${Math.max(0, Math.round(n))}px`;
      document.documentElement.style.setProperty(
        "--panel-seed",
        `${gap(shot.top - box.top)} ${gap(box.right - shot.right)} ` +
          `${gap(box.bottom - shot.bottom)} ${gap(shot.left - box.left)}`,
      );
    };
    if (!opening) seed();

    /*
      날짜 페이지의 첫 카드에는 아카이브 더미와 이어지는 이름이 이미 붙어 있다.
      끝나고 빈 값으로 되돌리면 그 이름이 사라져, 뒤로 갔을 때 더미로 되돌아가는
      전환이 조용히 죽는다. 원래 값을 들고 있다가 그대로 돌려놓는다.
    */
    const held = new Map<HTMLElement, string>();
    for (const el of [fromImage, toImage, panel]) {
      held.set(el, el.style.viewTransitionName);
    }

    /*
      이 전환과 상관없는 이름을 잠시 뗀다.

      날짜 페이지의 첫 카드에는 더미와 이어지는 이름이 상시로 붙어 있다. 그대로
      두고 <b>둘째 카드를 확대하면 그 첫 카드가 자기 이름 때문에 따로 떠올라</b>,
      어두워진 배경 위에 혼자 밝게 남는다 — 확대와 아무 관계가 없는 카드다.
      이름 붙은 요소는 루트 스냅샷에서 빠져 나와 그 위에 그려지기 때문이다.
    */
    const parked: [HTMLElement, string][] = [];
    for (const other of document.querySelectorAll<HTMLElement>("[data-vt]")) {
      if (held.has(other)) continue;
      if (!other.style.viewTransitionName) continue;
      parked.push([other, other.style.viewTransitionName]);
      other.style.viewTransitionName = "";
    }

    /*
      종이는 확대 뷰가 열려 있는 쪽에만 이름을 단다 — 여는 쪽에서는 "새로 생기는 것",
      닫는 쪽에서는 "사라지는 것"이 되어 두 경우가 저절로 갈린다. 짝을 지으면 크기가
      보간돼 글자가 눌리므로 일부러 한쪽에만 둔다.
    */
    if (!opening) panel.style.viewTransitionName = PANEL;

    fromImage.style.viewTransitionName = MORPH;
    const transition = document.startViewTransition(() => {
      fromImage.style.viewTransitionName = "";
      swap();
      toImage.style.viewTransitionName = MORPH;
      panel.style.viewTransitionName = opening ? PANEL : "";
      if (opening) seed();
    });
    // 이름을 남겨 두면 다음 전환이 "이름이 둘"인 상태로 들어가 아무것도 안 움직인다.
    transition.finished.finally(() => {
      for (const [el, name] of held) el.style.viewTransitionName = name;
      for (const [other, name] of parked) other.style.viewTransitionName = name;
      delete document.documentElement.dataset.cardMorph;
      document.documentElement.style.removeProperty("--panel-seed");
    });
  };

  for (const slide of document.querySelectorAll<HTMLElement>("[data-slide]")) {
    const shot = slide.querySelector<HTMLAnchorElement>(".shot");
    const expand = slide.querySelector<HTMLDialogElement>("[data-expand]");
    if (!shot || !expand) continue;

    const shotImage = shot.querySelector<HTMLImageElement>("img");
    const expandImage = expand.querySelector<HTMLImageElement>(".expand-shot");

    const open = () => {
      if (!shotImage || !expandImage) return expand.showModal();
      morph(shotImage, expandImage, expand, () => expand.showModal());
    };

    const close = () => {
      if (!expand.open) return;
      if (!shotImage || !expandImage) return expand.close();
      morph(expandImage, shotImage, expand, () => expand.close());
    };

    /*
      확대는 가운데 카드에서만. 옆 카드를 누르면 그 카드를 가운데로 옮기고 끝난다 —
      캐러셀에서 옆 카드를 누르는 것은 "저걸 보겠다"이지 "저걸 확대하겠다"가 아니다.

      한때 옆 카드도 한 번에 확대했다. 가운데가 아닌 카드는 트랙 밖으로 잘려 있어
      그대로 열면 전환이 잘리지 않은 카드 전체를 잡았다가 끝에서 잘린 모습으로
      돌아가므로, 열기 직전에 즉시 가운데로 세워야 했다. 그러면 닫을 때 그 자리를
      돌려주는 일이 또 따라붙어 <b>눌린 카드가 가운데로 왔다가 도로 밀려나는</b>
      왕복이 남는다. 확대를 가운데 카드로 좁히면 잘림도 되돌리기도 처음부터 없다.
    */
    const centerOrOpen = () => {
      if (slide.classList.contains("is-active")) return open();

      slide.scrollIntoView({
        behavior: quiet() ? "auto" : "smooth",
        inline: "center",
        block: "nearest",
      });
    };

    let startX = 0;
    let startY = 0;

    /*
      배선을 전부 `signal` 에 묶는다. DOM 이 교체되면 옛 요소와 함께 사라지므로
      지금은 없어도 도는데, 같은 요소에 두 번 걸리면 확대가 두 번 열려 두 번째
      `showModal` 이 던진다. 회수가 공짜라 굳이 그 위험을 남길 이유가 없다.
    */
    shot.addEventListener(
      "pointerdown",
      (event) => {
        startX = event.clientX;
        startY = event.clientY;
      },
      { passive: true, signal },
    );

    shot.addEventListener("click", (event) => {
      /*
        손가락이 흔들린 것과 누른 것을 가른다. 카드는 스와이프로 넘기는 물건이라
        넘기다 손이 미끄러지면 링크가 오발된다 — 지금까지 그게 원문 새 탭이었다.
      */
      const dragged =
        Math.abs(event.clientX - startX) > DRAG_SLOP ||
        Math.abs(event.clientY - startY) > DRAG_SLOP;

      // 끌었으면 아무 일도 일어나지 않는다. 나가지도, 확대되지도 않는다.
      event.preventDefault();
      if (!dragged) centerOrOpen();
    }, { signal });

    // 바깥을 누르면 닫는다. dialog 자신이 배경까지 차지하므로 좌표로 가른다.
    expand.addEventListener("click", (event) => {
      if (event.target !== expand) return;
      const box = expand.getBoundingClientRect();
      const inside =
        event.clientX >= box.left &&
        event.clientX <= box.right &&
        event.clientY >= box.top &&
        event.clientY <= box.bottom;
      if (!inside) close();
    }, { signal });

    /*
      ESC 와 닫기 버튼은 원래 브라우저가 알아서 닫는다. 그대로 두면 그 두 경로만
      효과 없이 툭 닫혀 열 때와 닫을 때가 어긋난다. 스크립트가 있을 때만 가로채고,
      없으면 원래대로 닫힌다 — 닫히지 않는 상태는 어느 경우에도 만들지 않는다.
    */
    expand.addEventListener("cancel", (event) => {
      event.preventDefault();
      close();
    }, { signal });

    expand.querySelector("[data-close]")?.addEventListener("click", (event) => {
      event.preventDefault();
      close();
    }, { signal });
  }

  for (const deck of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const track = deck.querySelector<HTMLElement>("[data-track]");
    const slides = [...deck.querySelectorAll<HTMLElement>("[data-slide]")];
    if (!track || slides.length < 2) continue;

    const prev = deck.querySelector<HTMLButtonElement>("[data-prev]");
    const next = deck.querySelector<HTMLButtonElement>("[data-next]");
    const dotsList = deck.querySelector<HTMLElement>("[data-dots]");
    const dots = [...deck.querySelectorAll<HTMLButtonElement>("[data-dot]")];

    let index = -1;

    const centered = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestDistance = Infinity;
      slides.forEach((slide, i) => {
        const distance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - center);
        if (distance < bestDistance) {
          bestDistance = distance;
          best = i;
        }
      });
      return best;
    };

    const sync = () => {
      const current = centered();
      if (current === index) return;
      index = current;

      slides.forEach((slide, i) => slide.classList.toggle("is-active", i === index));
      dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === index)));
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
    };

    const goTo = (target: number) => {
      const clamped = Math.min(Math.max(target, 0), slides.length - 1);
      // block: "nearest" 를 줘야 가로 이동이 페이지를 세로로 끌고 가지 않는다.
      slides[clamped].scrollIntoView({
        behavior: quiet() ? "auto" : "smooth",
        inline: "center",
        block: "nearest",
      });
    };

    let ticking = false;
    track.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          sync();
        });
      },
      { passive: true, signal },
    );

    // 슬라이드 폭이 뷰포트에 걸려 있어 창 크기가 바뀌면 중앙도 바뀐다.
    addEventListener("resize", sync, { passive: true, signal });

    track.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault(); // 기본 스크롤은 카드 단위가 아니라 픽셀 단위다
      goTo(index + (event.key === "ArrowRight" ? 1 : -1));
    }, { signal });

    prev?.addEventListener("click", () => goTo(index - 1), { signal });
    next?.addEventListener("click", () => goTo(index + 1), { signal });
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i), { signal }));

    if (prev) prev.hidden = false;
    if (next) next.hidden = false;
    if (dotsList) dotsList.hidden = false;
    deck.dataset.enhanced = "";
    sync();
    }
  };

  document.addEventListener("astro:page-load", setup);
</script>
