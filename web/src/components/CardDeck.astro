---
import type { RenderedCard } from "../lib/content";

interface Props {
  cards: RenderedCard[];
}

const { cards } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageBase = base.replace(/\/$/, "");
---

{/*
  가로 스와이프 캐러셀. 스크롤·스냅·스와이프는 전부 CSS(overflow + scroll-snap)가
  하고, JS 는 좌우 버튼과 도트만 얹는다. 그래서 스크립트가 실패하거나 아직 안
  왔어도 카드를 넘겨보는 일 자체는 된다 — 컨트롤은 JS 가 켜기 전까지 숨어 있다.
  외부 캐러셀 라이브러리를 쓰지 않는 이유는 웹폰트를 안 싣는 것과 같다: 이 페이지가
  하는 일에 비해 지불이 크다.
*/}
<section
  class="carousel"
  data-carousel
  role="region"
  aria-roledescription="캐러셀"
  aria-label="카드 목록"
>
  <div class="stage">
    {
      cards.length > 1 && (
        <button class="arrow arrow-prev" type="button" data-prev aria-label="이전 카드" hidden>
          <span aria-hidden="true">←</span>
        </button>
      )
    }

    <ol class="track" data-track tabindex="0">
      {
        cards.map((card, i) => (
          <li
            class:list={["slide", { "is-active": i === 0 }]}
            data-slide
            aria-roledescription="슬라이드"
            aria-label={`${i + 1} / ${cards.length}`}
          >
            <a class="shot" href={card.sourceUrl} target="_blank" rel="noopener noreferrer">
              {/*
                1080x1350 을 명시해 이미지가 늦게 와도 레이아웃이 밀리지 않게 한다.
                앞 두 장만 eager 로 받는다 — 가로 스크롤에서도 lazy 는 트랙 기준으로
                동작하므로 나머지는 넘길 때 받는다.
              */}
              <img
                src={`${imageBase}${card.image}`}
                width="1080"
                height="1350"
                alt={`${card.headline} — ${card.body}`}
                loading={i < 2 ? "eager" : "lazy"}
                decoding="async"
              />
            </a>
            <p class="meta">
              <a href={card.sourceUrl} target="_blank" rel="noopener noreferrer">
                {card.sourceName} 원문 보기 →
              </a>
            </p>
          </li>
        ))
      }
    </ol>

    {
      cards.length > 1 && (
        <button class="arrow arrow-next" type="button" data-next aria-label="다음 카드" hidden>
          <span aria-hidden="true">→</span>
        </button>
      )
    }
  </div>

  {
    cards.length > 1 && (
      <ol class="dots" data-dots hidden>
        {cards.map((_, i) => (
          <li>
            <button type="button" data-dot aria-label={`${i + 1}번째 카드로 이동`} />
          </li>
        ))}
      </ol>
    )
  }
</section>

<style>
  .carousel {
    /*
      카드는 4:5 세로다. 폭·뷰포트 높이 양쪽으로 상한을 걸어, 가로로 눕힌 화면에서
      카드 아래가 잘리지 않게 한다(55vh 폭 = 68.75vh 높이).
    */
    --slide: min(78vw, 420px, 55vh);
  }

  .stage {
    position: relative; /* 화살표를 이 안에서 절대배치하는 기준 */
  }

  .track {
    position: relative; /* 슬라이드 offsetLeft 를 트랙 기준으로 만든다(스크립트가 쓴다) */
    list-style: none;
    margin: 0;
    /* 첫 장과 마지막 장도 가운데에 설 수 있도록 좌우를 비워 둔다. */
    padding: 0 max(0px, calc((100% - var(--slide)) / 2));
    display: flex;
    gap: 20px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 20px;
  }

  .slide {
    flex: 0 0 var(--slide);
    scroll-snap-align: center;
  }

  /*
    가운데 카드만 또렷하게. 양옆은 다음 장이 있다는 신호로만 남긴다.
    이 흐림은 스크립트가 `data-enhanced` 를 붙인 뒤에만 건다 — 현재 장을 따라가는
    것도 스크립트라, 게이트가 없으면 JS 가 아직 안 왔거나 실패했을 때 카드 전체가
    흐린 채로 굳는다.
  */
  [data-enhanced] .slide:not(.is-active) {
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }

  .shot {
    display: block;
  }

  /*
    카드는 잉크 배경 위에 놓인 물건이다. 그림자를 줘야 배경에서 떠오르고,
    카드 안의 네이비가 배경과 붙어 보이지 않는다.
  */
  .slide img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    background: var(--ink-raised);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.5);
  }

  .meta {
    margin: 14px 2px 0;
    font-size: 12.5px;
    color: var(--dimmer);
    text-align: center;
  }

  .meta a {
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
  }

  .meta a:hover {
    color: var(--chalk);
    border-bottom-color: var(--edge);
  }

  /* 카드 폭 밖 여백에 앉는 원형 버튼. 기본은 숨김 — 640px 미만은 스와이프·도트로만 넘긴다. */
  .arrow {
    display: none;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--edge);
    border-radius: 50%;
    background: var(--ink-raised);
    color: var(--dim);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  /* JS 가 아직 안 왔거나 실패하면 화살표는 계속 숨어 있다 — 스와이프는 그대로 산다. */
  .arrow[hidden] {
    display: none;
  }

  .arrow:hover:not(:disabled) {
    border-color: var(--dim);
    color: var(--chalk);
  }

  .arrow:disabled {
    opacity: 0.25;
    cursor: default;
  }

  /*
    데스크톱·태블릿 이상에서만 화살표를 카드 옆에 띄운다. `.stage` 에 여백을
    미리 비워 둬 화살표가 앉을 자리가 배경(빈 공간)이 되게 한다 — 이웃 카드
    이미지를 밟지 않는다. 모바일은 그 여백을 확보할 폭이 없어 화살표를 접고
    스와이프·도트로만 넘긴다. `.arrow` 의 `display: none` 과 특이성이 같으므로
    이 규칙을 소스 순서상 뒤에 둬야 이긴다.
  */
  @media (min-width: 640px) {
    .stage {
      padding-inline: clamp(40px, 6vw, 56px);
    }

    .arrow-prev,
    .arrow-next {
      display: grid;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
    }

    .arrow-prev {
      left: 0;
    }

    .arrow-next {
      right: 0;
    }
  }

  .dots {
    margin: 22px 0 0;
    list-style: none;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .dots[hidden] {
    display: none;
  }

  .dots button {
    display: block;
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--edge);
    cursor: pointer;
    transition: background 0.2s ease, width 0.2s ease;
  }

  .dots button:hover {
    background: var(--dimmer);
  }

  /* 현재 위치는 이 페이지에서 앰버가 면으로 쓰이는 유일한 자리다. */
  .dots button[aria-current="true"] {
    width: 22px;
    border-radius: 4px;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    /* 흐림 규칙보다 특이성이 낮으면 안 먹으므로 같은 선택자로 되돌린다. */
    [data-enhanced] .slide:not(.is-active),
    .dots button,
    .arrow {
      transition: none;
    }
  }
</style>

<script>
  /*
    한 페이지에 덱이 하나뿐이지만 컴포넌트라 여러 개를 가정하고 각각 묶는다.
    현재 장 판정은 IntersectionObserver 가 아니라 "트랙 중앙에 가장 가까운 슬라이드"
    로 한다 — 데스크톱에서는 이웃 카드까지 온전히 보여서 교차 비율로는 가운데를
    가릴 수 없다.
  */
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const behavior: ScrollBehavior = reduceMotion ? "auto" : "smooth";

  for (const deck of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const track = deck.querySelector<HTMLElement>("[data-track]");
    const slides = [...deck.querySelectorAll<HTMLElement>("[data-slide]")];
    if (!track || slides.length < 2) continue;

    const prev = deck.querySelector<HTMLButtonElement>("[data-prev]");
    const next = deck.querySelector<HTMLButtonElement>("[data-next]");
    const dotsList = deck.querySelector<HTMLElement>("[data-dots]");
    const dots = [...deck.querySelectorAll<HTMLButtonElement>("[data-dot]")];

    let index = -1;

    const centered = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestDistance = Infinity;
      slides.forEach((slide, i) => {
        const distance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - center);
        if (distance < bestDistance) {
          bestDistance = distance;
          best = i;
        }
      });
      return best;
    };

    const sync = () => {
      const current = centered();
      if (current === index) return;
      index = current;

      slides.forEach((slide, i) => slide.classList.toggle("is-active", i === index));
      dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === index)));
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
    };

    const goTo = (target: number) => {
      const clamped = Math.min(Math.max(target, 0), slides.length - 1);
      // block: "nearest" 를 줘야 가로 이동이 페이지를 세로로 끌고 가지 않는다.
      slides[clamped].scrollIntoView({ behavior, inline: "center", block: "nearest" });
    };

    let ticking = false;
    track.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          sync();
        });
      },
      { passive: true },
    );

    // 슬라이드 폭이 뷰포트에 걸려 있어 창 크기가 바뀌면 중앙도 바뀐다.
    addEventListener("resize", sync, { passive: true });

    track.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault(); // 기본 스크롤은 카드 단위가 아니라 픽셀 단위다
      goTo(index + (event.key === "ArrowRight" ? 1 : -1));
    });

    prev?.addEventListener("click", () => goTo(index - 1));
    next?.addEventListener("click", () => goTo(index + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

    if (prev) prev.hidden = false;
    if (next) next.hidden = false;
    if (dotsList) dotsList.hidden = false;
    deck.dataset.enhanced = "";
    sync();
  }
</script>
