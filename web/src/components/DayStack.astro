---
import type { Day } from "../lib/content";

interface Props {
  day: Day;
}

const { day } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageBase = base.replace(/\/$/, "");

const [, month, dayOfMonth] = day.date.split("-");
const weekday = ["일", "월", "화", "수", "목", "금", "토"][
  new Date(`${day.date}T00:00:00Z`).getUTCDay()
];

const cover = day.cards[0];

/*
  표지 뒤에 깔릴 층. 카드가 5장이면 4겹이 뒤에 쌓여 더미가 5장 두께로 보인다.
  두께가 곧 그날 발행한 장수라, 아카이브를 훑기만 해도 조용한 날과 그렇지 않은
  날이 구분된다 — 장식이 아니라 정보다.
*/
const leaves = Array.from({ length: Math.max(0, day.cards.length - 1) }, (_, i) => i + 1);
---

<a class="stack" href={`${base}${day.date}/`} aria-label={`${month}월 ${dayOfMonth}일 발행 카드 ${day.cards.length}장 보기`}>
  <span class="pile">
    {leaves.map((i) => <span class="leaf" style={`--i:${i}`} aria-hidden="true" />)}

    {/*
      날짜 페이지의 첫 카드와 같은 이름을 달아 둔다. 이름이 같은 두 요소를
      브라우저가 하나로 보고 위치·크기를 이어 붙인다 — 더미 표지가 그대로
      커지며 그날의 첫 카드가 된다.

      `data-vt` 는 그 이름을 되읽기 위한 표시다. 이동 직전에 `Layout` 이 양쪽
      문서의 이름을 대조해 짝이 없는 쪽을 떼어 낸다.
    */}
    <img
      class="cover"
      data-vt={`cover-${day.date}`}
      style={`view-transition-name: cover-${day.date}`}
      src={`${imageBase}${cover.image}`}
      width="1080"
      height="1350"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </span>

  <span class="label">
    <span class="date">
      <span class="mm">{month}</span><span class="sep">.</span><span class="dd">{dayOfMonth}</span>
    </span>
    <span class="meta">{weekday}요일 · {day.cards.length}장</span>
  </span>
</a>

<style>
  .stack {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /*
    더미의 자리. 층들이 위·오른쪽으로 삐져나오므로 그만큼 여백을 미리 잡아 둔다.
    안 잡으면 이웃 칸과 겹치고, 격자에서 마지막 칸이 잘린다.
  */
  .pile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    margin: 24px 28px 0 0;
  }

  .leaf,
  .cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 10px;
  }

  /*
    뒤로 갈수록 위·오른쪽으로 조금씩 밀리고 옅어진다. 종이 더미를 위에서 비스듬히
    본 모습이다. 층 자체는 빈 면이라 표지 이미지만 실제로 내려받으면 된다.
  */
  .leaf {
    /*
      크림 위에서는 층이 흰 종이 한 장씩이다. 배경보다 밝게 띄우고 테두리로
      가장자리를 그으면 겹쳐 쌓인 인쇄물로 읽힌다 — 다크에서는 층을 배경보다
      밝게 만들어야 해서 억지스러웠는데, 종이 바탕에서는 그게 자연스럽다.
    */
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    transform: translate(calc(var(--i) * 6px), calc(var(--i) * -6px))
      rotate(calc(var(--i) * 0.5deg));
    opacity: calc(1 - var(--i) * 0.14);
    transition:
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.32s ease;
  }

  .cover {
    object-fit: cover;
    background: var(--paper-sunken);
    border: 1px solid var(--rule);
    box-shadow: 0 10px 24px rgba(22, 24, 29, 0.16);
    transition:
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.32s ease;
  }

  /* 호버·포커스에서 더미가 부채꼴로 벌어진다. 이 페이지에서 유일하게 큰 움직임이다. */
  .stack:hover .leaf,
  .stack:focus-visible .leaf {
    /*
      가로로는 넉넉히 벌리고 세로는 아낀다. 세로를 같이 키우면 5장짜리 더미가
      섹션 구분선을 넘어 올라간다 — 장수가 많은 날일수록 더 튄다.
    */
    transform: translate(calc(var(--i) * 13px), calc(var(--i) * -7px))
      rotate(calc(var(--i) * 1.9deg));
    opacity: calc(1 - var(--i) * 0.1);
  }

  .stack:hover .cover,
  .stack:focus-visible .cover {
    transform: translateY(3px);
    box-shadow: 0 16px 34px rgba(22, 24, 29, 0.24);
  }

  .label {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 16px;
  }

  /*
    날짜는 이 사이트의 파일 이름이다. 등폭 숫자로 크게 세워 목록에서 눈이
    숫자만 따라 내려갈 수 있게 한다.
  */
  .date {
    font-size: 29px;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .sep {
    color: var(--accent);
    margin: 0 1px;
  }

  .dd {
    color: var(--text);
  }

  .mm {
    color: var(--text-soft);
    /* 층은 0.32s 로 벌어지는데 숫자만 툭 바뀌면 둘이 한 동작으로 안 읽힌다. */
    transition: color 0.32s ease;
  }

  .meta {
    font-size: 12.5px;
    color: var(--text-faint);
  }

  .stack:hover .mm {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .leaf,
    .cover {
      transition: none;
    }

    .stack:hover .leaf,
    .stack:focus-visible .leaf,
    .stack:hover .cover,
    .stack:focus-visible .cover {
      transform: translate(calc(var(--i, 0) * 6px), calc(var(--i, 0) * -6px))
        rotate(calc(var(--i, 0) * 0.5deg));
    }
  }
</style>
