---
import type { GetStaticPaths } from "astro";
import CardDeck from "../../components/CardDeck.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, listDays, type Day } from "../../lib/content";

export const getStaticPaths = (() => {
  const days = listDays();
  return days.map((day, i) => ({
    params: { date: day.date },
    // 아카이브는 날짜순으로 앞뒤를 오갈 수 있어야 한다. 목록은 최신순이라 다음 날이 앞이다.
    props: { day, newer: days[i - 1] ?? null, older: days[i + 1] ?? null },
  }));
}) satisfies GetStaticPaths;

interface Props {
  day: Day;
  newer: Day | null;
  older: Day | null;
}

const { day, newer, older } = Astro.props;
const base = import.meta.env.BASE_URL;

const [year, month, dayOfMonth] = day.date.split("-");

/** pager 라벨은 `07.26` 처럼 짧게. 본문의 큰 날짜와 같은 표기다. */
const short = (d: string) => d.slice(5).replace("-", ".");
---

<Layout
  title={`${formatDate(day.date)} AI 뉴스 카드`}
  description={day.cards.map((card) => card.headline).join(" · ")}
>
  <section class="day">
    <p class="eyebrow">발행 기록</p>

    {/* 히어로와 같은 괘선 한 줄. 두 페이지가 같은 장부의 다른 행으로 읽힌다. */}
    <div class="dateline">
      <h1 class="bigdate">
        {month}<span class="sep">.</span>{dayOfMonth}
      </h1>
      <span class="yr">{year}</span>
    </div>
  </section>

  <CardDeck cards={day.cards} />

  <nav class="pager" aria-label="다른 발행일">
    {
      older ? (
        <a href={`${base}${older.date}/`} rel="prev">
          <span class="dir">이전</span>
          <span class="num">{short(older.date)}</span>
        </a>
      ) : (
        <span />
      )
    }

    <a class="home" href={base}>전체 보기</a>

    {
      newer ? (
        <a class="next" href={`${base}${newer.date}/`} rel="next">
          <span class="dir">다음</span>
          <span class="num">{short(newer.date)}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</Layout>

<style>
  .day {
    padding: clamp(28px, 6vw, 56px) 0 clamp(24px, 4vw, 40px);
  }

  .dateline {
    margin-top: 8px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1.5px solid var(--text);
    padding-bottom: clamp(6px, 1vw, 12px);
  }

  .bigdate {
    margin: 0;
    font-size: clamp(58px, 13vw, 116px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.92;
    font-variant-numeric: tabular-nums;
  }

  /* 히어로와 같은 이유로 줄인다 — 이 크기의 마침표는 원형 덩어리로 읽힌다. */
  .sep {
    font-size: 0.44em;
    vertical-align: 0.06em;
    color: var(--accent);
    margin: 0 0.06em;
  }

  .yr {
    font-size: clamp(13px, 1.6vw, 16px);
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .pager {
    margin-top: clamp(48px, 7vw, 72px);
    border-top: 1px solid var(--rule);
    padding-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .pager a {
    text-decoration: none;
    color: var(--text-soft);
  }

  .pager a:hover {
    color: var(--accent);
  }

  /* 앞뒤 링크는 방향 라벨 위에 날짜를 얹어 둘을 한 덩어리로 읽게 한다. */
  .pager a:not(.home) {
    display: grid;
    gap: 2px;
    line-height: 1.2;
  }

  .next {
    text-align: right;
  }

  .dir {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .num {
    font-size: 17px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .home {
    font-size: 12px;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }

  .home:hover {
    border-bottom-color: var(--accent);
  }
</style>
