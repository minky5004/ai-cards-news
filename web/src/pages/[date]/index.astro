---
import type { GetStaticPaths } from "astro";
import CardDeck from "../../components/CardDeck.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, listDays, type Day } from "../../lib/content";

export const getStaticPaths = (() => {
  const days = listDays();
  return days.map((day, i) => ({
    params: { date: day.date },
    // 아카이브는 날짜순으로 앞뒤를 오갈 수 있어야 한다. 목록은 최신순이라 다음 날이 앞이다.
    props: { day, newer: days[i - 1] ?? null, older: days[i + 1] ?? null },
  }));
}) satisfies GetStaticPaths;

interface Props {
  day: Day;
  newer: Day | null;
  older: Day | null;
}

const { day, newer, older } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout
  title={`${formatDate(day.date)} AI 뉴스 카드`}
  description={day.cards.map((card) => card.headline).join(" · ")}
>
  <section class="hero">
    <p class="eyebrow">발행</p>
    <h1>{formatDate(day.date)}</h1>
    <p class="count">카드 {day.cards.length}장</p>
  </section>

  <CardDeck cards={day.cards} />

  <nav class="pager">
    {older ? <a href={`${base}${older.date}/`}>← {formatDate(older.date)}</a> : <span></span>}
    {newer ? <a href={`${base}${newer.date}/`}>{formatDate(newer.date)} →</a> : <span></span>}
  </nav>
</Layout>

<style>
  .hero {
    padding: 40px 0 36px;
  }

  .eyebrow {
    margin: 0 0 8px;
    font-size: 13px;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  h1 {
    margin: 0;
    font-size: clamp(30px, 6vw, 44px);
    letter-spacing: -0.02em;
  }

  .count {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--muted);
  }

  .pager {
    margin-top: 56px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    font-size: 14px;
  }

  .pager a {
    text-decoration: none;
    color: var(--muted);
  }

  .pager a:hover {
    color: var(--accent);
  }
</style>
