---
import type { GetStaticPaths } from "astro";
import ArchiveGrid from "../../components/ArchiveGrid.astro";
import CardDeck from "../../components/CardDeck.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, listDays, slides, type Day } from "../../lib/content";

export const getStaticPaths = (() => {
  const days = listDays();
  return days.map((day, i) => ({
    params: { date: day.date },
    /*
      앞뒤 하나씩과 목록 전체를 함께 넘긴다. 페이저는 옆날로 새는 동작이고 격자는
      아무 날로 가는 동작이라, 하나가 다른 하나를 대신하지 못한다.
    */
    // 아카이브는 날짜순으로 앞뒤를 오갈 수 있어야 한다. 목록은 최신순이라 다음 날이 앞이다.
    props: { day, days, newer: days[i - 1] ?? null, older: days[i + 1] ?? null },
  }));
}) satisfies GetStaticPaths;

interface Props {
  day: Day;
  days: Day[];
  newer: Day | null;
  older: Day | null;
}

const { day, days, newer, older } = Astro.props;
const base = import.meta.env.BASE_URL;

/*
  보고 있는 날짜는 뺀다. 섹션 이름이 "다른 발행" 이기도 하고, 07.28 을 보는 중에
  07.28 더미를 누르면 같은 페이지로 가는 막다른 길이 된다.
*/
const others = days.filter((d) => d.date !== day.date);

const [year, month, dayOfMonth] = day.date.split("-");

/** pager 라벨은 `07.26` 처럼 짧게. 본문의 큰 날짜와 같은 표기다. */
const short = (d: string) => d.slice(5).replace("-", ".");
---

<Layout
  title={`${formatDate(day.date)} AI 뉴스 카드`}
  description={slides(day).map((slide) => slide.title).join(" · ")}
>
  <section class="day">
    <p class="eyebrow">발행 기록</p>

    {/* 히어로와 같은 괘선 한 줄. 두 페이지가 같은 장부의 다른 행으로 읽힌다. */}
    <div class="dateline">
      <h1 class="bigdate">
        {month}<span class="sep">.</span>{dayOfMonth}
      </h1>
      <span class="yr">{year}</span>
    </div>
  </section>

  {/* 홈 아카이브 더미의 표지와 짝이 되는 이름. 더미에서 이 페이지로 이어진다. */}
  <CardDeck slides={slides(day)} coverName={`cover-${day.date}`} />

  <nav class="pager" aria-label="다른 발행일">
    {
      older ? (
        <a href={`${base}${older.date}/`} rel="prev">
          <span class="dir">이전</span>
          <span class="num">{short(older.date)}</span>
        </a>
      ) : (
        <span />
      )
    }

    <a class="home" href={base}>전체 보기</a>

    {
      newer ? (
        <a class="next" href={`${base}${newer.date}/`} rel="next">
          <span class="dir">다음</span>
          <span class="num">{short(newer.date)}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>

  {/*
    페이저 아래에 둔다. 범위가 좁은 것에서 넓은 것 순서다 — 페이저는 옆날 하나,
    격자는 아무 날. 이 격자가 없던 동안에는 특정 날짜로 가는 길이 이전/다음
    연타뿐이었고, 홈 아카이브도 여덟 개에서 끊겨 있어 오래된 날짜에 닿을 방법이
    사실상 없었다.
  */}
  {
    others.length > 0 && (
      <section class="others">
        <p class="eyebrow">다른 발행</p>
        <ArchiveGrid days={others} />
      </section>
    )
  }
</Layout>

<style>
  .day {
    padding: clamp(28px, 6vw, 56px) 0 clamp(24px, 4vw, 40px);
  }

  .dateline {
    margin-top: 8px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1.5px solid var(--text);
    padding-bottom: clamp(6px, 1vw, 12px);
  }

  .bigdate {
    margin: 0;
    font-size: clamp(58px, 13vw, 116px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.92;
    font-variant-numeric: tabular-nums;
  }

  /* 히어로와 같은 이유로 줄인다 — 이 크기의 마침표는 원형 덩어리로 읽힌다. */
  .sep {
    font-size: 0.44em;
    vertical-align: 0.06em;
    color: var(--accent);
    margin: 0 0.06em;
  }

  .yr {
    font-size: clamp(13px, 1.6vw, 16px);
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .pager {
    margin-top: clamp(48px, 7vw, 72px);
    border-top: 1px solid var(--rule);
    padding-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .pager a {
    text-decoration: none;
    color: var(--text-soft);
    /* 캐러셀 화살표는 부드럽고 바로 아래 페이저는 툭 바뀌면 손맛이 갈린다. */
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .pager a:hover {
    color: var(--accent);
  }

  /* 앞뒤 링크는 방향 라벨 위에 날짜를 얹어 둘을 한 덩어리로 읽게 한다. */
  .pager a:not(.home) {
    display: grid;
    gap: 2px;
    line-height: 1.2;
  }

  .next {
    text-align: right;
  }

  .dir {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .num {
    font-size: 17px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .home {
    font-size: 12px;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }

  .home:hover {
    border-bottom-color: var(--accent);
  }

  /* 홈의 `지난 발행` 과 같은 간격·괘선. 두 페이지가 같은 장부의 다른 행으로 읽힌다. */
  .others {
    padding: clamp(28px, 6vw, 56px) 0 0;
  }

  .others .eyebrow {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 12px;
    margin-bottom: clamp(24px, 3.5vw, 38px);
  }
</style>
