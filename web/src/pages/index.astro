---
import ArchiveGrid from "../components/ArchiveGrid.astro";
import CardDeck from "../components/CardDeck.astro";
import Layout from "../layouts/Layout.astro";
import { listDays } from "../lib/content";

const days = listDays();
const [latest, ...past] = days;

const parts = latest ? latest.date.split("-") : null;
---

<Layout title="AI NEWS — 오늘의 AI 뉴스 카드">
  {
    latest && parts ? (
      <>
        {/*
          히어로는 날짜 그 자체다. 이 사이트의 단위가 날짜이고 아카이브의 파일
          이름도 날짜라, 다른 무엇을 앞에 세우면 구조를 흐린다.
        */}
        <section class="today">
          <p class="eyebrow">오늘 발행</p>

          {/*
            날짜와 연도를 괘선 양 끝에 밀어 붙인다. 둘을 나란히 두면 그냥 큰
            글자지만, 사이를 괘선으로 벌려 놓으면 장부에 찍힌 한 줄로 읽힌다 —
            매일 기계가 한 줄씩 적어 내려가는 사이트라 그 은유가 구조와 맞는다.
          */}
          <div class="dateline">
            <h1 class="bigdate">
              {parts[1]}<span class="sep">.</span>{parts[2]}
            </h1>
            <span class="yr">{parts[0]}</span>
          </div>
        </section>

        <CardDeck cards={latest.cards} />

        {past.length > 0 && (
          <section class="archive">
            <p class="eyebrow">지난 발행</p>
            <ArchiveGrid days={past} />
          </section>
        )}
      </>
    ) : (
      /* 파이프라인이 아직 한 번도 돌지 않았거나 렌더까지 간 날이 없을 때. */
      <section class="today empty">
        <p class="eyebrow">대기 중</p>
        <div class="dateline">
          <h1 class="bigdate">--<span class="sep">.</span>--</h1>
        </div>
        <p class="sub">첫 발행을 기다리고 있습니다. 매일 밤 카드가 쌓입니다.</p>
      </section>
    )
  }
</Layout>

<style>
  .today {
    margin-top: clamp(36px, 5vw, 60px);
    padding: 0 0 clamp(24px, 4vw, 40px);
  }

  .empty {
    margin-top: 0;
    border-top: 0;
  }

  /* 날짜와 연도가 앉는 괘선. 굵기를 본문색으로 줘야 인쇄된 선처럼 단호하다. */
  .dateline {
    margin-top: 8px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1.5px solid var(--text);
    padding-bottom: clamp(6px, 1vw, 12px);
  }

  /*
    날짜를 이 페이지에서 가장 큰 것으로 세운다. 등폭 숫자라 자릿수가 바뀌어도
    폭이 흔들리지 않고, 음수 자간으로 조여야 이 크기에서 덩어리로 읽힌다.
  */
  .bigdate {
    margin: 0;
    font-size: clamp(58px, 13vw, 116px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.92;
    font-variant-numeric: tabular-nums;
  }

  /*
    이 크기에서 마침표는 점이 아니라 원형 덩어리로 읽힌다. 크기를 크게 줄이고
    시각 중심으로 올려야 두 숫자를 잇는 구분자로 보인다.
  */
  .sep {
    font-size: 0.44em;
    vertical-align: 0.06em;
    color: var(--accent);
    margin: 0 0.06em;
  }

  .yr {
    font-size: clamp(13px, 1.6vw, 16px);
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .sub {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--text-soft);
  }

  .archive {
    padding: clamp(28px, 6vw, 56px) 0 0;
  }

  /* 아카이브 라벨도 히어로와 같은 괘선을 받아 두 섹션이 같은 장부로 읽히게 한다. */
  .archive .eyebrow {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 12px;
    margin-bottom: clamp(24px, 3.5vw, 38px);
  }

</style>
