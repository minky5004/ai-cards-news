---
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "매일 밤, 그날의 AI 뉴스를 카드로." } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>

    {/*
      아카이브 더미를 누르면 그 표지가 날짜 페이지의 첫 카드 자리로 이어진다 —
      더미에서 한 장을 뽑아 펼치는 동작이 화면에서 그대로 보인다. 지원하지 않는
      브라우저는 그냥 평범한 링크 이동이 된다.
    */}
    <ClientRouter />
  </head>
  <body>
    {/*
      시각을 못박지 않는다. 21:00 KST 는 cron 예약이지 발행 시각이 아니다 —
      GitHub 의 schedule 은 큐라서 정각(`0` 분)일수록 밀린다. 31회 관측에서 40분~9시간
      57분 늦었고 중앙값은 1시간 10분이다. 파이프라인 자체는 2~3분이라 이 지연은 전부
      실행 시작 전에 생긴다.
    */}
    <header class="site">
      <span class="stamp">매일 밤 자동 발행</span>
    </header>

    <main><slot /></main>

    <footer class="site">
      <span>사람이 만지지 않는 파이프라인이 매일 카드를 쌓습니다.</span>
      <a href="https://github.com/minky5004/ai-cards-news">소스 보기</a>
    </footer>
  </body>
</html>

<style is:global>
  /*
    종이(크림) 바탕이다. 다크를 두 번 냈다가 두 번 다 반려됐고, 그 뒤에 실제로
    도는 뉴스 다이제스트를 찍어 봤더니 뉴닉·롱블랙·Tangle·Techmeme 넷 다 밝은
    배경이었다. 다크는 이 장르의 관습이 아니었다.

    액센트는 카드 이미지에서 빌려 온 잉크 네이비 하나다. 크림 위에 네이비는
    인쇄물의 기본 짝이고, 카드가 바로 그 네이비라 UI 와 카드가 한 시스템으로
    읽힌다. 색을 새로 들여오지 않고 이미 있는 것을 쓰는 쪽이 맞다.

    토큰 이름은 뜻하는 바 그대로다 — 예전에는 `--ink` 가 배경, `--chalk` 가
    글자였는데 팔레트가 뒤집히면 이름이 거짓말을 한다.

    웹폰트는 싣지 않는다. 페이지의 글자는 카드 이미지 밖의 보조 텍스트뿐이고,
    한글 Noto Sans KR 은 한 굵기당 540KB 라 이 정도 텍스트에 지불할 값이 아니다.
    카드 안의 타이포그래피는 이미 이미지에 구워져 있다. 개성은 폰트를 사 오는
    대신 크기 대비와 괘선으로 낸다 — 날짜를 등폭 숫자로 크게 앉히고 그 아래
    괘선을 긋는 것이 이 페이지의 타이포 시그니처다.
  */
  :root {
    --paper: #f4f1e8;
    --paper-raised: #fbfaf5;
    --paper-sunken: #e9e4d5;
    --rule: #d6cfbc;
    --rule-soft: rgba(22, 24, 29, 0.12);
    --text: #16181d;
    --text-soft: #5d5a52;
    --text-faint: #8f897c;
    --accent: #23407e;

    --shell: 1120px;
    --gutter: clamp(18px, 4vw, 32px);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--text);
    font-family:
      "Pretendard", "Apple SD Gothic Neo", "Malgun Gothic", system-ui, -apple-system,
      sans-serif;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  main {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 0 var(--gutter) 96px;
  }

  /* 라벨은 기계가 찍은 것처럼. 자동 파이프라인이 이 사이트의 정체다. */
  .eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  header.site {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 22px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .stamp {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  footer.site {
    max-width: var(--shell);
    margin: 0 auto;
    border-top: 1px solid var(--rule);
    padding: 26px var(--gutter) 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 12.5px;
    color: var(--text-faint);
  }

  footer.site a {
    color: var(--text-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
    /* 화살표·도트만 부드럽고 링크는 툭 바뀌면 같은 화면 안에서 손맛이 갈린다. */
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  footer.site a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 520px) {
    .stamp {
      display: none;
    }
  }

  /*
    이어 붙일 카드가 없는 이동은 두 화면을 겹치지 않고 순차로 넘긴다.

    기본값은 교차 페이드라 옛 화면과 새 화면이 동시에 반투명하게 뜬다. 두 페이지의
    스크롤 위치가 다르면 그게 곧 이중노출이 된다 — 페이저는 화면 아래에 있어 누르려면
    스크롤을 내려야 하고, 새 페이지는 맨 위에서 시작한다. 실제로 <b>07.26 과 07.27 이
    127px 어긋난 채 동시에 읽히는 프레임</b>을 찍었다. 먼저 지우고 그다음에 세우면
    둘이 만나는 순간이 없다.

    짝이 맞은 이동(더미 → 날짜)에는 걸지 않는다. 거기서는 카드가 두 화면을 잇는
    실이라 배경도 이어져야 한다 — `data-page-swap` 을 스크립트가 그때만 뗀다.
    확대 전환도 제외한다. 그쪽은 교차 페이드가 곧 배경이 서서히 깔리는 연출이다.
  */
  html[data-page-swap]:not([data-card-morph])::view-transition-old(root) {
    animation: page-out 100ms ease both;
    mix-blend-mode: normal;
  }

  html[data-page-swap]:not([data-card-morph])::view-transition-new(root) {
    animation: page-in 170ms ease 100ms both;
    mix-blend-mode: normal;
  }

  @keyframes page-out {
    to {
      opacity: 0;
    }
  }

  @keyframes page-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  /*
    이동마다 `view-transition-name` 을 <b>새로 만든다.</b> 마크업에는 이름의 후보만
    `data-vt` 로 있고, 실제 이름은 짝이 될 둘에만 여기서 붙는다.

    이름을 마크업에 박으면 그 이동과 상관없는 짝이 생긴다. 아카이브 격자는 홈에도
    날짜 페이지에도 실리고 타일은 발행일 수만큼이라, 박아 둔 채로 07.29 → 07.27 을
    누르면 <b>다섯 쌍이 한꺼번에 짝이 맞아</b> 표지 하나가 커지는 대신 화면 전체가
    제각기 흘러간다. 짝이 하나도 없을 때만 거는 순차 페이드도 그때 같이 꺼진다.

    규칙은 하나다 — <b>짝은 한 쌍 · 새 문서의 덱 표지가 우선.</b> 표지를 눌러 그날로
    들어가는 것이 이 전환의 뜻이므로, 들어가는 쪽 덱이 짝의 한쪽이다. 홈으로 되돌아갈
    때는 그 자리가 비므로 나가는 쪽 덱 표지를 짝으로 삼아 더미로 되돌아간다.

    `[data-vt]` 가 이름의 단일 출처다. 인라인 스타일에서 되읽지 않는 것은, 카드
    확대가 전환 도중 인라인 값을 갈아 끼우기 때문이다.
  */
  const named = (root: ParentNode) => {
    const found = new Map<string, HTMLElement>();
    for (const el of root.querySelectorAll<HTMLElement>("[data-vt]")) {
      const name = el.dataset.vt;
      if (name) found.set(name, el);
    }
    return found;
  };

  /** 그 문서가 날짜 페이지일 때 덱 첫 카드의 이름. 홈의 덱에는 이름이 없다. */
  const cover = (root: ParentNode) =>
    root.querySelector<HTMLElement>("[data-carousel] [data-vt]")?.dataset.vt ?? null;

  const reconcile = (incoming: Document) => {
    const before = named(document);
    const after = named(incoming);

    /*
      모션을 줄인 설정에서는 짝을 아예 만들지 않는다. 카드가 화면을 가로질러
      날아가는 것이 이 사이트에서 유일한 "움직임"이고, 이름을 떼고 남는 교차
      페이드는 움직임이 아니라 밝기 변화다. 페이지 이동 자체를 없애면 어디로
      갔는지 알 수 없어져 오히려 불친절하다.
    */
    const quiet = matchMedia("(prefers-reduced-motion: reduce)").matches;

    for (const el of before.values()) el.style.viewTransitionName = "";
    for (const el of after.values()) el.style.viewTransitionName = "";

    /** 들어가는 쪽 덱으로 이어지는 짝. 더미를 눌러 그날로 들어가는 이동이다. */
    const entering = cover(incoming);
    /** 나가는 쪽 덱에서 나오는 짝. 홈으로 되돌아가 더미에 다시 앉는 이동이다. */
    const leaving = cover(document);

    const pair = quiet
      ? null
      : entering && before.has(entering)
        ? entering
        : leaving && after.has(leaving)
          ? leaving
          : null;

    /** 새 문서에서 짝이 맞은 요소. 펼치기를 걸지 말지가 여기 달렸다. */
    let landing: HTMLElement | null = null;

    if (pair) {
      before.get(pair)!.style.viewTransitionName = pair;
      landing = after.get(pair)!;
      landing.style.viewTransitionName = pair;
    }

    /*
      펼치기는 표지에서 이어졌을 때만 뜻이 있다. 마크업에 박아 두면 새로고침이나
      즐겨찾기로 바로 들어온 사람에게도 걸려, <b>첫 장만 있고 나머지 자리가 한동안
      비어 있는 화면</b>이 뜬다 — 도트는 넉 장인데 카드는 한 장이라 고장으로 읽힌다.

      들어가는 쪽 덱으로 이어진 짝일 때만 건다. 날짜에서 홈으로 되돌아갈 때는 짝이
      아카이브 더미라, 홈의 오늘 발행까지 덩달아 펼쳐질 이유가 없다.
    */
    const deck = incoming.querySelector("[data-carousel]");
    if (deck && pair && pair === entering) deck.setAttribute("data-unfold", "");

    /*
      이어 붙일 카드가 없으면 배경을 순차로 넘긴다(위 전역 스타일). 표시는 <b>양쪽
      문서에 다</b> 걸어야 한다 — 교체 시점에 `<html>` 속성이 새 문서 것으로 갈리므로,
      한쪽만 걸면 전환이 도는 도중에 규칙이 빠져 애니메이션이 끊긴다.
    */
    document.documentElement.toggleAttribute("data-page-swap", !landing);
    incoming.documentElement.toggleAttribute("data-page-swap", !landing);
  };

  /*
    `astro:before-swap` 에 걸면 안 된다 — 그 이벤트는 이미 `startViewTransition`
    <b>안에서</b> 발화하고, 나가는 화면의 스냅샷은 그보다 먼저 찍힌다. 실제로 그렇게
    걸었더니 들어오는 쪽 이름만 떨어지고 <b>나가는 쪽은 그대로 페이드아웃했다.</b>

    새 문서를 받아 오는 loader 를 감싸면 두 조건이 동시에 선다 — `newDocument` 는
    이미 채워져 있고, 전환은 아직 시작되지 않았다.
  */
  document.addEventListener("astro:before-preparation", (event) => {
    const load = event.loader;
    event.loader = async () => {
      await load();
      reconcile(event.newDocument);
    };
  });
</script>
